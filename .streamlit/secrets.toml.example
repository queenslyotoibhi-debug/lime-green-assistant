# Copy to .streamlit/secrets.toml for local runs (that path is gitignored).
# On Streamlit Community Cloud, paste the same line into the app's Secrets box
# instead — Settings → Secrets.
#
# Create a free key at https://aistudio.google.com/apikey (no card required).

GEMINI_API_KEY = "your-key-here"

# Optional: choose the generation model without editing code. Free-tier daily
# quotas are per model, so this is the knob to reach for when one runs dry.
# GEMINI_CHAT_MODEL = "gemini-3.5-flash-lite"
